# Copy to .env for the local demo. These are LOCAL placeholders for SeaweedFS/MinIO
# on localhost - never put real AWS keys in a file in this repository.

# Where memories live: s3://bucket/prefix, file://DIR or memory://
S3_AGENT_MEMORY_URL=s3://agent-memory/demo
S3_AGENT_MEMORY_NAMESPACE=users/alice

# Local S3-compatible endpoint (SeaweedFS from docker-compose.yml; MinIO uses :9000).
S3_AGENT_MEMORY_ENDPOINT_URL=http://localhost:8333
AWS_ACCESS_KEY_ID=local-dev
AWS_SECRET_ACCESS_KEY=local-dev-only
AWS_DEFAULT_REGION=us-east-1

# Server-side encryption on AWS S3: AES256, aws:kms or aws:kms:dsse (+ key id for KMS).
# S3_AGENT_MEMORY_SSE=AES256
# S3_AGENT_MEMORY_KMS_KEY_ID=

# Optional local embeddings: none | fastembed | sentence-transformers
S3_AGENT_MEMORY_EMBEDDINGS=none
# S3_AGENT_MEMORY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# consolidate --summariser ollama (local open-weight model)
S3_AGENT_MEMORY_OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434
